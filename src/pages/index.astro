---
import Layout from '../layouts/Layout.astro';
import ResearchProject from '../components/ResearchProject';
import {
  aboutSections,
  certifications,
  contactIntro,
  contactMethods,
  education,
  experiences,
  expertise,
  funFacts,
  opportunities,
  profile,
  quickFacts,
  researchProjects,
  volunteering,
} from '../data/siteContent';
---

<Layout title="Hrish Leen" description={profile.description}>
  <div class="home-stack">
    <section class="panel" aria-labelledby="hero-title">
      <div class="hero-top">
        <img
          class="hero-portrait"
          src="/images/selfie.jpg"
          alt="Photo of Hrish Leen"
          width="144"
          height="144"
          loading="eager"
        />

        <div class="hero-text">
          <p class="section-kicker">{profile.greeting}</p>
          <h1 id="hero-title" class="hero-title">{profile.name}</h1>
          <p class="hero-subtitle">
            {profile.title} at {profile.institution}
          </p>

          <div class="link-row">
            {profile.links.map((link) => (
              <a
                href={link.href}
                class="link-chip"
                download={link.download ? true : undefined}
                target={link.href.startsWith('http') ? '_blank' : undefined}
                rel={link.href.startsWith('http') ? 'noreferrer noopener' : undefined}
              >
                {link.label}
              </a>
            ))}
          </div>
        </div>
      </div>

      {profile.intro.map((paragraph) => (
        <p>{paragraph}</p>
      ))}

      <p class="section-kicker mt-3">{profile.interestsLabel}</p>
      <div class="interest-list">
        {profile.interests.map((interest) => (
          <span class="interest-chip">{interest}</span>
        ))}
      </div>

      <p class="mb-0 mt-3">{profile.simHint}</p>
    </section>

    <section id="research" class="panel" aria-labelledby="research-title">
      <div class="section-heading">
        <p class="section-kicker">Featured Research</p>
        <h2 id="research-title">Research Projects</h2>
        <p class="mb-0">
          The homepage now carries the full research content directly in the main flow, inspired by the simple single-page structure of
          {' '}
          <a href="https://www.nicklashansen.com/" target="_blank" rel="noreferrer noopener">Nicklas Hansen's site</a>.
        </p>
      </div>

      <div class="research-stack">
        {researchProjects.map((project) => (
          <ResearchProject client:load {...project} />
        ))}
      </div>
    </section>

    <section class="panel" aria-labelledby="resume-title">
      <div class="section-heading">
        <p class="section-kicker">Resume</p>
        <h2 id="resume-title">Experience</h2>
      </div>

      <div class="timeline-group">
        <div class="timeline-subsection">
          <div class="timeline-list">
            {experiences.map((experience) => (
              <article class="timeline-entry">
                {experience.logo && (
                  <img
                    class="timeline-logo"
                    src={experience.logo.src}
                    alt={experience.logo.alt}
                    loading="lazy"
                    width="52"
                    height="52"
                  />
                )}

                <div class="timeline-copy">
                  <div class="timeline-heading-row">
                    <h3>{experience.title}</h3>
                    <span class="timeline-period">{experience.period}</span>
                  </div>
                  <p class="timeline-org">{experience.organization}</p>
                  <p>{experience.description}</p>
                  {experience.bullets.length > 0 && (
                    <ul>
                      {experience.bullets.map((bullet) => (
                        <li>{bullet}</li>
                      ))}
                    </ul>
                  )}
                </div>
              </article>
            ))}
          </div>
        </div>

        <div class="timeline-subsection">
          <h3>Education</h3>
          <div class="timeline-list">
            {education.map((entry) => (
              <article class="timeline-entry">
                {entry.logo && (
                  <img
                    class="timeline-logo"
                    src={entry.logo.src}
                    alt={entry.logo.alt}
                    loading="lazy"
                    width="52"
                    height="52"
                  />
                )}

                <div class="timeline-copy">
                  <div class="timeline-heading-row">
                    <h3>{entry.degree}</h3>
                    <span class="timeline-period">{entry.period}</span>
                  </div>
                  <p class="timeline-org">{entry.institution}</p>

                  {entry.details.length > 0 && (
                    <p class="detail-inline">
                      {entry.details.map((detail) => (
                        <span>
                          {detail.href ? (
                            <a href={detail.href} target="_blank" rel="noreferrer noopener">
                              {detail.text}
                            </a>
                          ) : (
                            detail.text
                          )}
                        </span>
                      ))}
                    </p>
                  )}
                </div>
              </article>
            ))}
          </div>
        </div>

        <div class="timeline-subsection">
          <h3>Teaching & Volunteering</h3>
          <div class="timeline-list">
            {volunteering.map((entry) => (
              <article class="timeline-entry">
                {entry.logo && (
                  <img
                    class="timeline-logo"
                    src={entry.logo.src}
                    alt={entry.logo.alt}
                    loading="lazy"
                    width="52"
                    height="52"
                  />
                )}

                <div class="timeline-copy">
                  <div class="timeline-heading-row">
                    <h3>{entry.title}</h3>
                    <span class="timeline-period">{entry.period}</span>
                  </div>
                  <p class="timeline-org">{entry.organization}</p>
                  <p>{entry.description}</p>
                  {entry.bullets.length > 0 && (
                    <ul>
                      {entry.bullets.map((bullet) => (
                        <li>{bullet}</li>
                      ))}
                    </ul>
                  )}
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="panel" aria-labelledby="about-title">
      <div class="section-heading">
        <p class="section-kicker">About Me</p>
        <h2 id="about-title">Get to know me better</h2>
      </div>

      <div class="about-grid">
        <div class="about-main">
          {aboutSections.map((section) => (
            <section>
              <h3>{section.title}</h3>
              {section.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}

              {section.title === 'What I Do' && (
                <div class="expertise-grid">
                  {expertise.map((item) => (
                    <article class="expertise-item">
                      <h3>{item.title}</h3>
                      <p>{item.description}</p>
                    </article>
                  ))}
                </div>
              )}
            </section>
          ))}
        </div>

        <aside class="about-side">
          <article class="mini-card">
            <h3>Quick Facts</h3>
            <div class="fact-list">
              {quickFacts.map((fact) => (
                <div class="fact-row">
                  <span>{fact.label}</span>
                  <span>{fact.value}</span>
                </div>
              ))}
            </div>
          </article>

          <article class="mini-card">
            <h3>Certifications</h3>
            <div class="fact-list">
              {certifications.map((item) => (
                <div class="fact-row">
                  <span>{item.title}</span>
                  <span>{item.detail}</span>
                </div>
              ))}
            </div>
          </article>

          <article class="mini-card">
            <h3>Fun Facts</h3>
            <ul class="plain-list">
              {funFacts.map((fact) => (
                <li>{fact}</li>
              ))}
            </ul>
          </article>
        </aside>
      </div>
    </section>

    <section id="contact" class="panel" aria-labelledby="contact-title">
      <div class="section-heading">
        <p class="section-kicker">{contactIntro.heading}</p>
        <h2 id="contact-title">{contactIntro.sectionTitle}</h2>
        <p>{contactIntro.subheading}</p>
        <p class="mb-0">{contactIntro.body}</p>
      </div>

      <div class="contact-methods">
        {contactMethods.map((method) => (
          <article class="contact-method">
            <h3>{method.title}</h3>
            <p>{method.detail}</p>
            <a href={method.href} target={method.href.startsWith('http') ? '_blank' : undefined} rel={method.href.startsWith('http') ? 'noreferrer noopener' : undefined}>
              {method.action}
            </a>
          </article>
        ))}
      </div>

      <div class="section-heading mt-4">
        <h3>What I'm Looking For</h3>
      </div>

      <div class="opportunity-grid">
        {opportunities.map((opportunity) => (
          <article class="opportunity-card">
            <h3>{opportunity.title}</h3>
            <p class="mb-0">{opportunity.description}</p>
          </article>
        ))}
      </div>
    </section>
  </div>
</Layout>
