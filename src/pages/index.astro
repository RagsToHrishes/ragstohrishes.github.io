---
import Layout from '../layouts/Layout.astro';
import ResearchProject from '../components/ResearchProject';
import {
  contactIntro,
  contactMethods,
  education,
  experiences,
  profile,
  researchProjects,
  volunteering,
} from '../data/siteContent';

const heroGreetingLead = profile.greeting.endsWith(profile.name)
  ? profile.greeting.slice(0, -profile.name.length).trimEnd()
  : profile.greeting;
---

<Layout title="Hrish Leen" description={profile.description}>
  <div class="home-stage" id="home-stage">
    <div class="panel panel-shell home-panel" data-panel-shell>
      <section class="content-section" aria-labelledby="hero-title">
        <div class="hero-top">
          <img
            class="hero-portrait"
            src="/images/selfie.jpg"
            alt="Photo of Hrish Leen"
            width="144"
            height="144"
            loading="eager"
          />

          <div class="hero-text">
            <h1 id="hero-title" class="hero-title">
              {heroGreetingLead} <span class="hero-title-name">{profile.name}</span>
            </h1>
            <p class="hero-subtitle">
              {profile.title} at {profile.institution}
            </p>

            <div class="link-row">
              {profile.links.map((link) => (
                <a
                  href={link.href}
                  class="link-chip"
                  download={link.download ? true : undefined}
                  target={link.href.startsWith('http') ? '_blank' : undefined}
                  rel={link.href.startsWith('http') ? 'noreferrer noopener' : undefined}
                >
                  {link.label}
                </a>
              ))}
            </div>
          </div>
        </div>

        {profile.intro.map((paragraph) => (
          <p>{paragraph}</p>
        ))}

        <p class="section-kicker mt-3">{profile.interestsLabel}</p>
        <div class="interest-list">
          {profile.interests.map((interest) => (
            <span class="interest-chip">{interest}</span>
          ))}
        </div>

        <p class="mb-0 mt-3">{profile.simHint}</p>
      </section>

      <section id="research" class="content-section" aria-labelledby="research-title">
        <div class="section-heading">
          <p class="section-kicker">Featured Research</p>
          <h2 id="research-title">Research Projects</h2>
        </div>

        <div class="research-stack">
          {researchProjects.map((project) => (
            <ResearchProject client:visible {...project} />
          ))}
        </div>
      </section>

      <section class="content-section" aria-labelledby="resume-title">
        <div class="section-heading">
          <p class="section-kicker">Resume</p>
          <h2 id="resume-title">Experience</h2>
        </div>

        <div class="timeline-group">
          <div class="timeline-subsection">
            <div class="timeline-list">
              {experiences.map((experience) => (
                <article class="timeline-entry">
                  {experience.logo && (
                    <img
                      class="timeline-logo"
                      src={experience.logo.src}
                      alt={experience.logo.alt}
                      loading="lazy"
                      width="52"
                      height="52"
                    />
                  )}

                  <div class="timeline-copy">
                    <div class="timeline-heading-row">
                      <h3>{experience.title}</h3>
                      <span class="timeline-period">{experience.period}</span>
                    </div>
                    <p class="timeline-org">{experience.organization}</p>
                    <p>{experience.description}</p>
                    {experience.bullets.length > 0 && (
                      <ul>
                        {experience.bullets.map((bullet) => (
                          <li>{bullet}</li>
                        ))}
                      </ul>
                    )}
                  </div>
                </article>
              ))}
            </div>
          </div>

          <div class="timeline-subsection">
            <h3>Education</h3>
            <div class="timeline-list">
              {education.map((entry) => (
                <article class="timeline-entry">
                  {entry.logo && (
                    <img
                      class="timeline-logo"
                      src={entry.logo.src}
                      alt={entry.logo.alt}
                      loading="lazy"
                      width="52"
                      height="52"
                    />
                  )}

                  <div class="timeline-copy">
                    <div class="timeline-heading-row">
                      <h3>{entry.degree}</h3>
                      <span class="timeline-period">{entry.period}</span>
                    </div>
                    <p class="timeline-org">{entry.institution}</p>

                    {entry.details.length > 0 && (
                      <p class="detail-inline">
                        {entry.details.map((detail) => (
                          <span>
                            {detail.href ? (
                              <a href={detail.href} target="_blank" rel="noreferrer noopener">
                                {detail.text}
                              </a>
                            ) : (
                              detail.text
                            )}
                          </span>
                        ))}
                      </p>
                    )}
                  </div>
                </article>
              ))}
            </div>
          </div>

          <div class="timeline-subsection">
            <h3>Teaching & Volunteering</h3>
            <div class="timeline-list">
              {volunteering.map((entry) => (
                <article class="timeline-entry">
                  {entry.logo && (
                    <img
                      class="timeline-logo"
                      src={entry.logo.src}
                      alt={entry.logo.alt}
                      loading="lazy"
                      width="52"
                      height="52"
                    />
                  )}

                  <div class="timeline-copy">
                    <div class="timeline-heading-row">
                      <h3>{entry.title}</h3>
                      <span class="timeline-period">{entry.period}</span>
                    </div>
                    <p class="timeline-org">{entry.organization}</p>
                    <p>{entry.description}</p>
                    {entry.bullets.length > 0 && (
                      <ul>
                        {entry.bullets.map((bullet) => (
                          <li>{bullet}</li>
                        ))}
                      </ul>
                    )}
                  </div>
                </article>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section id="contact" class="content-section" aria-labelledby="contact-title">
        <div class="section-heading">
          <p class="section-kicker">{contactIntro.heading}</p>
          <h2 id="contact-title">{contactIntro.sectionTitle}</h2>
          <p>{contactIntro.subheading}</p>
          <p class="mb-0">{contactIntro.body}</p>
        </div>

        <div class="contact-methods">
          {contactMethods.map((method) => (
            <article class="contact-method">
              <h3>{method.title}</h3>
              <p>{method.detail}</p>
              <a href={method.href} target={method.href.startsWith('http') ? '_blank' : undefined} rel={method.href.startsWith('http') ? 'noreferrer noopener' : undefined}>
                {method.action}
              </a>
            </article>
          ))}
        </div>
      </section>
    </div>
  </div>
</Layout>
