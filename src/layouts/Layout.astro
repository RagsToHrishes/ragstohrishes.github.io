---
import PowerGridBackground from '../components/PowerGridBackground';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  usePachinko?: boolean;
}

const { title, description = 'Personal website and portfolio' } = Astro.props;
const year = new Date().getFullYear();
const isHomePage = Astro.url.pathname === '/';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class={isHomePage ? 'is-homepage' : undefined}>
    <PowerGridBackground client:load />

    <div class="site-root">
      <header class="site-nav">
        <a href="/" class="site-brand" aria-label="Home">
          Hrish Leen
        </a>
        <nav class="site-actions" aria-label="Primary">
          <a href="/resume.pdf" class="site-action site-action--primary" download>
            Resume
          </a>
          <a href="/#contact" class="site-action">
            Contact
          </a>
        </nav>
      </header>

      <main class="page-main">
        <slot />
      </main>

      <footer class="site-footer">
        <p>© {year} Hrish Leen.</p>
      </footer>
    </div>
  </body>
</html>

<style>
  .site-root {
    position: relative;
    z-index: 2;
    min-height: 100vh;
    padding: 0 0 var(--spacing-2xl);
  }

  .site-nav {
    position: sticky;
    top: 0;
    z-index: 30;
    width: 100%;
    margin: 0;
    padding: 1.2rem var(--spacing-lg) 1rem;
    box-sizing: border-box;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--spacing-lg);
    backdrop-filter: blur(8px);
  }

  .site-brand {
    color: var(--color-text-primary);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.86rem;
    font-weight: 800;
  }

  .site-brand:hover,
  .site-brand:focus-visible {
    color: var(--color-accent);
  }

  .site-actions {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
  }

  .site-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 6.5rem;
    padding: 0.72rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: rgba(245, 245, 245, 0.78);
    color: var(--color-text-primary);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    transition:
      transform var(--transition-fast),
      border-color var(--transition-fast),
      background var(--transition-fast),
      color var(--transition-fast);
  }

  .site-action:hover,
  .site-action:focus-visible {
    transform: translateY(-1px);
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: rgba(245, 245, 245, 0.92);
  }

  .site-action--primary {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-bg-primary);
  }

  .site-action--primary:hover,
  .site-action--primary:focus-visible {
    background: var(--color-accent-secondary);
    border-color: var(--color-accent-secondary);
    color: var(--color-bg-primary);
  }

  .page-main,
  .site-footer {
    position: relative;
    z-index: 2;
    width: 100%;
    box-sizing: border-box;
  }

  .page-main {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 var(--spacing-lg);
  }

  .site-footer {
    padding: 0.5rem var(--spacing-lg) 1rem;
    font-size: 0.8rem;
    color: var(--color-text-tertiary);
  }

  .site-footer p {
    margin: 0;
  }

  @media (max-width: 640px) {
    .site-root {
      padding-left: var(--spacing-md);
      padding-right: var(--spacing-md);
    }

    .site-nav {
      flex-direction: column;
      align-items: flex-start;
    }

    .site-actions {
      width: 100%;
    }

    .site-action {
      flex: 1 1 0;
      min-width: 0;
    }
  }
</style>
